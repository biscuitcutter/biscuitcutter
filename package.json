{
  "name": "biscuitcutter-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "link": "npm link --workspace=biscuitcutter",
    "unlink": "npm unlink --global biscuitcutter",
    "changeset": "npx @changesets/cli"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
